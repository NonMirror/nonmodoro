<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nonmirror.nonmodoro"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <permission
        android:name="com.nonmirror.nonmodoro.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.nonmirror.nonmodoro.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.nonmirror.nonmodoro.NomoApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nonmodoro" >
        <activity
            android:name="com.nonmirror.nonmodoro.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@style/Theme.Nonmodoro"
            android:windowSoftInputMode="adjustResize" /> <!-- Candle -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Candle"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_candle"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_candle"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Stones -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Stones"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_stones"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_stones"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Sprout -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Sprout"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sprout"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_sprout"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Target -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Target"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_target"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_target"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Sitter -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Sitter"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sitter"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_sitter"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Bell -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Bell"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bell"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_bell"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Cat -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Cat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cat"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_cat"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Alarm -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Alarm"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alarm"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_alarm"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Snail -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Snail"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_snail"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_snail"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias> <!-- Hourglass -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Hourglass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_hourglass"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_hourglass"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!--
          The launcher entry lives on activity-aliases, not on MainActivity, so the
          user can change the app icon at runtime: exactly one alias is enabled and
          it carries the matching icon. See data/AppIcon.kt.
        -->
        <!-- Tomato -->
        <activity-alias
            android:name="com.nonmirror.nonmodoro.icon.Tomato"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tomato"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_tomato"
            android:targetActivity="com.nonmirror.nonmodoro.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.nonmirror.nonmodoro.timer.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the focus timer running and shows the live countdown in a notification." />
        </service>

        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.nonmirror.nonmodoro.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>